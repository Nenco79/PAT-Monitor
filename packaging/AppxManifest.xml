<?xml version="1.0" encoding="utf-8"?>
<!--
  The package manifest, as a template: `{VERSION}` is substituted at build time
  and nothing else is.

  **The token is deliberately not a valid version.** A placeholder like 0.0.0.0
  would build, install and ship a package claiming to be older than every other,
  and the Store would refuse the one after it for not going up - all without an
  error anywhere. An unsubstituted `{VERSION}` fails at MakeAppx, which is the
  moment somebody is standing there.

  **Identity is Partner Center's, character for character, and cannot be
  guessed.** Name, Publisher and PublisherDisplayName are the values the account
  was assigned when the app was reserved; the upload is refused if any of them
  differs. The package comes out unsigned, since the Store re-signs it; to
  sideload it for a test it has to be signed with a certificate whose subject
  is exactly this Publisher, the account's own CN, a GUID.

  **The logos are not listed twice.** The three files named below are what
  `icon.PackageLogos` draws, and a test holds the two together: a name changed
  on one side and not the other is a package the shell draws its fallback for,
  with no error from anywhere.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="Nenco.PATMonitor"
            Publisher="CN=61AD2E3D-A9AA-4664-AF28-98FEA404237C"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PAT Monitor</DisplayName>
    <PublisherDisplayName>Nenco</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!--
    Every language the catalogues carry. A package declaring only one is a
    package the Store lists in one, whatever the program speaks.

    The tag here and the catalogue's filename are not the same string, and they
    are not meant to be: the Store wants a full BCP-47 tag, while a catalogue is
    named by the language alone - `zh.json` serves `zh-CN`, `zh-SG` and every
    other region, because `i18n.pick` cuts at the first hyphen. What is held is
    therefore the part before that hyphen, which is the only part the two
    documents agree about. See TestTheManifestNamesEveryLanguageTheProgramHas.
  -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="it-it" />
    <Resource Language="de-de" />
    <Resource Language="fr-fr" />
    <Resource Language="es-es" />
    <Resource Language="zh-hans" />
  </Resources>

  <!--
    `runFullTrust` is what keeps this a desktop program rather than an
    AppContainer one: the loopback listener, WASAPI in exclusive mode and the
    hardware encoders all depend on it. The two device capabilities are what
    make the camera and the microphone grantable per package - without them the
    consent the program asks for does not exist to be given.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="microphone" />
  </Capabilities>

  <Applications>
    <Application Id="PATMonitor" Executable="pat-monitor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PAT Monitor"
        Description="Pet and toddler monitor: webcam and microphone over WebRTC"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
